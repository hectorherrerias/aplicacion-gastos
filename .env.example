# Server Configuration
PORT=3000
NODE_ENV=production

# Port published on the Docker host
HOST_PORT=3001

# Security & JWT Token
# Leave empty to auto-generate a random secret stored in data/.jwt_secret
# (generate your own with: openssl rand -hex 48)
JWT_SECRET=

# Default Administrator Credentials (only used on first boot, when the DB has no users)
ADMIN_USER=admin
ADMIN_PASSWORD=change_me_please

# Set to false to block creation of new accounts from the login screen
ALLOW_REGISTRATION=true

# Automatic daily SQLite backups in data/backups
BACKUP_ENABLED=true
BACKUP_KEEP_DAYS=14

# Database configuration (SQLite file)
DATA_DIR=./data
DATABASE_FILE=./data/database.sqlite
